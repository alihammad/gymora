rules_version = '2';

// Each signed-in user can read and write only their own data under users/{uid},
// and only in the collections the app syncs (see SyncEngine). Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && collection in ['exercises', 'routines', 'workouts', 'measurements', 'settings']
        && request.resource.data.keys().hasOnly(['updatedAt', 'deleted', 'data', 'serverUpdatedAt'])
        && request.resource.data.updatedAt is int
        && request.resource.data.deleted is bool
        && request.resource.data.data is map
        && request.resource.data.serverUpdatedAt == request.time;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
  }
}
