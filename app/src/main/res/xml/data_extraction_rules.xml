<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup and device-to-device transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="exercise_media/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="exercise_media/" />
    </device-transfer>
</data-extraction-rules>
